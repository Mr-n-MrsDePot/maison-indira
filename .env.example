# Live keys only (Dashboard → API keys). Never commit these.
# Needed so pay stays on maisonindira.com instead of leaving the site.
# Live Maison Indira keys only. Never sk_test_ / pk_test_.
# Put these in Vercel Environment Variables, not in git.
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_

# Public site origin for Stripe return URLs (set this on Vercel).
# Example: https://maisonindira.com
SITE_URL=http://localhost:5222
